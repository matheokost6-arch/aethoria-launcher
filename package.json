{
  "name": "aethoria-launcher",
  "version": "1.1.1",
  "description": "Launcher officiel du serveur Minecraft Aethoria",
  "main": "src/main/main.js",
  "author": "Aethoria",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "deploy": "node tools/deploy.js",
    "deploy:launcher": "node tools/deploy.js --skip-pack",
    "deploy:rapide": "node tools/deploy.js --skip-pack --skip-build"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  }
}
